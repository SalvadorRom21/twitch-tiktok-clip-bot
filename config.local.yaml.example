# Copy this file to config.local.yaml and fill in your Twitch credentials.
#
#   cp config.local.yaml.example config.local.yaml
#
# Get credentials: https://dev.twitch.tv/console/apps
# OAuth Redirect URL (required by Twitch, not used by this app): http://localhost:3000
#
# Find your broadcaster_id (numeric Twitch user ID):
#   curl -s "https://api.twitch.tv/helix/users?login=YOUR_TWITCH_USERNAME" \
#     -H "Client-Id: YOUR_CLIENT_ID"

twitch:
  client_id: "PASTE_CLIENT_ID_HERE"
  client_secret: "PASTE_CLIENT_SECRET_HERE"
  broadcaster_id: "PASTE_NUMERIC_USER_ID_HERE"
  max_clips: 5
  max_vods: 3

vod:
  max_shorts_per_vod: 5
  min_short_gap_sec: 120
  # Set to 3600 to only download/process first hour while testing
  max_download_sec: 0

# GPU transcription (NVIDIA): whisper_device: cuda, whisper_compute_type: float16
# analysis:
#   whisper_model: small
#   whisper_device: cuda
#   whisper_compute_type: float16

# Cursor agent edit plans (set CURSOR_API_KEY in .env — no OpenAI key needed)
# llm:
#   enabled: true
#   provider: cursor
#   cursor_model: composer-2.5

# Publish desk — platform auth (Connections UI at /auth)
# YouTube: Desktop OAuth JSON → Connect Google
# TikTok: client_key/secret + Login Kit redirect http://127.0.0.1:8766/callback/
# Instagram: Meta app_id/secret + redirect http://127.0.0.1:8765/callback/
# Export packs still work without API auth (phone upload).
publish:
  youtube:
    client_secrets_file: secrets/youtube_client_secret.json
    token_file: data/youtube_token.json
    category_id: "20"
    privacy_status: private
  tiktok:
    client_secrets_file: secrets/tiktok_client_secret.json
    token_file: data/tiktok_token.json
    oauth_port: 8766
  instagram:
    client_secrets_file: secrets/instagram_client_secret.json
    token_file: data/instagram_token.json
    oauth_port: 8765
