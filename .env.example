# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Twitch API: https://dev.twitch.tv/console/apps
# OAuth Redirect URL (required by Twitch, not used by this app): http://localhost:3000

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=

# Optional: OpenAI-compatible API for smarter edit plans + vision
OPENAI_API_KEY=
