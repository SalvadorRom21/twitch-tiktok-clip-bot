# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Twitch API: https://dev.twitch.tv/console/apps
# OAuth Redirect URL (required by Twitch, not used by this app): http://localhost:3000

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=

# Cursor agent for smarter edit plans (recommended — no OpenAI key needed)
# Get key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: OpenAI-compatible API instead of Cursor (set llm.provider: openai)
OPENAI_API_KEY=

# YouTube Shorts: put OAuth Desktop client JSON at secrets/youtube_client_secret.json
# TikTok: {"client_key":"...","client_secret":"..."} → secrets/tiktok_client_secret.json
# Instagram: {"app_id":"...","app_secret":"..."} → secrets/instagram_client_secret.json
# Then open http://127.0.0.1:8081/auth to Connect each platform.
