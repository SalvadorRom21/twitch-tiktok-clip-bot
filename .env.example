# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Twitch API: https://dev.twitch.tv/console/apps
# OAuth Redirect URL (required by Twitch, not used by this app): http://localhost:3000

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=

# Cursor agent for smarter edit plans (recommended — no OpenAI key needed)
# Get key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: OpenAI-compatible API instead of Cursor (set llm.provider: openai)
OPENAI_API_KEY=
